# Server
PORT=3000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9201
ELASTICSEARCH_PRODUCT_INDEX=products
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Cache TTLs, in seconds. 0 disables caching for that endpoint (used by e2e tests).
SEARCH_CACHE_TTL_SECONDS=60
AUTOCOMPLETE_CACHE_TTL_SECONDS=300
